# ─── AI ──────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_claude_api_key_here
CLAUDE_MODEL=claude-sonnet-4-20250514

# ─── MARKET DATA ─────────────────────────────────────────────────────────────
FINNHUB_API_KEY=your_free_finnhub_key

# ─── DATABASE ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://trader:password@localhost:5432/tradingassistant
REDIS_URL=redis://localhost:6379

# ─── NOTIFICATIONS ───────────────────────────────────────────────────────────
SENDGRID_API_KEY=optional
ALERT_EMAIL=your@email.com

# ─── USER PROFILE ────────────────────────────────────────────────────────────
USER_NAME=Trader
DEFAULT_CURRENCY=AUD
HOME_MARKET=ASX
PORTFOLIO_VALUE_AUD=5000
RISK_PER_TRADE_PCT=1.5
MAX_POSITION_SIZE_PCT=10.0

# ─── CORE ETF HOLDINGS (monitor only — format: SYMBOL:UNITS:AVG_COST_AUD) ───
CORE_HOLDINGS=VAS.AX:0:0.00,IHVV.AX:0:0.00

# ─── PORTFOLIO RISK LIMITS ───────────────────────────────────────────────────
MAX_SECTOR_CONCENTRATION_PCT=35.0
MAX_PORTFOLIO_BETA=1.5
CORRELATION_WARNING_THRESHOLD=0.75

# ─── BROKER: CMC MARKETS (cost model only — no API keys) ────────────────────
CMC_AU_THRESHOLD=1000.00
CMC_AU_FLAT_FEE=9.90
CMC_FX_SPREAD_PCT=0.0065

# ─── MARKET REGIME ───────────────────────────────────────────────────────────
REGIME_VIX_ELEVATED=20.0
REGIME_VIX_EXTREME=30.0
REGIME_ADX_TRENDING=25.0
REGIME_BREADTH_BULLISH=0.60

# ─── CONFLUENCE ENGINE ───────────────────────────────────────────────────────
CONFLUENCE_MIN_STRATEGIES=2
CONFLUENCE_PRIORITY_THRESHOLD=3

# ─── SCANNING ────────────────────────────────────────────────────────────────
SCAN_UNIVERSE=ASX200,SP500
SCAN_INTERVAL_MINUTES=15
AI_ANALYSIS_DAILY_LIMIT=50

# ─── IDEA LIFECYCLE ──────────────────────────────────────────────────────────
IDEA_MAX_AGE_DAYS=5
IDEA_ENTRY_MISS_PCT=3.0

# ─── CLOUDFLARE ──────────────────────────────────────────────────────────────
CLOUDFLARE_TUNNEL_TOKEN=your_tunnel_token_here
CLOUDFLARE_DOMAIN=trading.yourdomain.com

# ─── APP ─────────────────────────────────────────────────────────────────────
API_PORT=8000
FRONTEND_PORT=3000
SECRET_KEY=replace_this_with_a_long_random_string_at_least_32_chars
LOG_LEVEL=INFO
